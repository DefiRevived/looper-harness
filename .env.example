# --- Chain (Base mainnet) ---
BASE_RPC_URL=https://mainnet.base.org
# Base Sepolia (testnet) RPC — used by the web3 tools; public fallbacks rotate if empty.
BASE_SEPOLIA_RPC_URL=
LOOPER_CONTRACT=0x1649CD37f4748807b4882FC48765bA0B2aFfa94a
# Optional — pin one Looper token id for headless runs (bots / mcp / dreams).
# Leave empty and the console activates any Looper you own (ownership verified);
# switch agents anytime from the top bar — each keeps its own memory and builds.
LOOPER_TOKEN_ID=
# Optional callsign the operator gives the agent (e.g. its Telegram display name).
# Empty = the agent uses only its on-chain identity (Looper #N).
LOOPER_CALLSIGN=
# Optional: the agent's own Telegram handle (e.g. @myagent_bot) so it knows
# that pings aimed at the handle are addressed to it.
LOOPER_HANDLE=

# --- Agent brain (DeepSeek, OpenAI-compatible API) ---
# Leave the key empty to run a labeled MOCK brain (canned replies, not the
# agent's persona). The setup wizard / ⚙ panel stores a key locally in
# looper.config.json; this env var, when set, overrides it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Valid API model names: deepseek-flash, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.7
# Output ceiling for every reply. Set explicitly on purpose: without it the
# provider's DEFAULT applies, and a large tool call (a whole build file) can be
# cut off mid-JSON — which reaches the agent as "unparseable arguments" with no
# explanation. Verified accepted up to 65536 against api.deepseek.com.
LOOPER_MAX_OUTPUT_TOKENS=32768

# --- Web console ---
HOST=127.0.0.1
PORT=4520

# --- Bots (optional; run `npm run bot`) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- Access control (all optional; defaults keep everything local & open) ---
# Ownership gate: activation requires one gas-free wallet signature proving the
# signer owns the token (checked against ownerOf on Base). Default ON; set to
# false to browse/activate any Looper without a wallet (demo / read-only use).
LOOPER_REQUIRE_OWNERSHIP=true
# API token: empty = no auth. Set it only if you ever expose the server.
# Bootstrap the console once with http://127.0.0.1:4520/?token=YOUR_TOKEN
LOOPER_API_TOKEN=
# Chat throttle per client IP per minute. 0 = disabled.
CHAT_RATE_LIMIT_PER_MINUTE=0
# Max chat message length (sanity bound).
LOOPER_MAX_MESSAGE_CHARS=4000
# run_module sandbox: when Node's permission model cannot be enforced on the
# platform, the tool refuses by default (fail closed). true = allow unguarded
# module execution anyway (you accept the risk).
LOOPER_RUN_UNSANDBOXED=false
# Bot allowlists: empty = open to anyone who messages the bot (startup warns).
# Comma-separated ids; blocked attempts are logged with the id to copy in.
TELEGRAM_ALLOWED_CHAT_IDS=
DISCORD_ALLOWED_USER_IDS=

# --- Storage ---
# Where memory, sessions, transcripts and caches are stored. Empty = ./data.
# The first-run setup wizard (and the console's ⚙ panel) writes both directory
# choices to looper.config.json; env vars here override the file.
LOOPER_DATA_DIR=
# Where builds and npm projects are stored. Empty = <dataDir>/artifacts.
LOOPER_BUILDS_DIR=

# Nightly dream pass (ReMEM): after DREAM_HOUR, synthesize durable memory into a journal entry
DREAM_ENABLED=true
DREAM_HOUR=3
