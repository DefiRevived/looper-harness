{
  "name": "looper-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "DefiRevived",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DefiRevived/looper-harness.git"
  },
  "homepage": "https://github.com/DefiRevived/looper-harness#readme",
  "bugs": "https://github.com/DefiRevived/looper-harness/issues",
  "description": "Local agent runtime for a Looper NFT (Base) — activates a token's codex as a working agent with a web console, build workspace, research tools, MCP server and Telegram/Discord adapters.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "bot": "tsx watch src/bot/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "libs": "node scripts/fetch-libs.mjs",
    "pack-build": "tsx scripts/pack-build.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts --prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@darksol/remem": "^0.25.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "grammy": "^1.30.0",
    "playwright-core": "^1.63.0",
    "viem": "^2.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
